{
  "name": "pinbu-patchwork-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate:assets": "node scripts/generate-assets.mjs",
    "fetch:textures": "node scripts/fetch-textures.mjs",
    "process:textures": "python3 scripts/process-textures.py && python3 scripts/build-overview.py && node scripts/generate-assets.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
